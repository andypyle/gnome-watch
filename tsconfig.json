{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "moduleDetection": "auto",
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "out"
  },
  "include": ["src", "hook", "scripts", "test", "renderer"]
}
